# Postgres connection string (Vercel can't resolve IPv6, so use the pooled/IPv4 host your provider gives you)
DATABASE_URL=postgres://user:password@host:5432/salvage_tracker

# Filled in once eBay Developer access is set up (Inventory API + Trading API)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

# Object storage for part photos (Supabase Storage or S3-compatible)
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Free key from https://aistudio.google.com/apikey — powers BOL document intake extraction
GOOGLE_GENERATIVE_AI_API_KEY=
